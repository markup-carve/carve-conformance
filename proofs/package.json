{
  "name": "@markup-carve/carve-proofs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Checked models of Carve parsing rules",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "proof:layout": "node scripts/layout-proof-check.mjs",
    "proof:layout:evidence": "node scripts/layout-proof-check.mjs --evidence-only",
    "check:properties": "node scripts/property-check.mjs",
    "bench:scaling": "node scripts/scaling-check.mjs",
    "report:properties": "node scripts/report-properties.mjs",
    "check:comparison": "node scripts/comparison/check.mjs",
    "bench:comparison": "node scripts/comparison/bench.mjs",
    "report:comparison": "node scripts/comparison/report.mjs",
    "profile:nesting": "node scripts/profiling/run.mjs",
    "report:profiling": "node scripts/profiling/report.mjs",
    "build:djot-v": "node scripts/djot-v/build.mjs",
    "check:djot-v": "node scripts/djot-v/check.mjs",
    "proof:djot-v": "node scripts/djot-v/proofs.mjs",
    "bench:djot-v": "node scripts/djot-v/bench.mjs",
    "report:djot-v": "node scripts/djot-v/report.mjs",
    "check:djot-extensions": "node scripts/djot-v/extensions.mjs",
    "proof:djot-extensions": "node scripts/djot-v/extensions-proof.mjs",
    "build:djot-differential": "node scripts/differential/build.mjs",
    "check:djot-differential": "node scripts/differential/run.mjs",
    "proof:djot-differential": "node scripts/differential/proof.mjs",
    "report:djot-differential": "node scripts/differential/report.mjs",
    "build:ownership": "node scripts/ownership/build.mjs",
    "check:ownership": "node scripts/ownership/run.mjs",
    "reduce:ownership": "node scripts/ownership/reduce.mjs",
    "build:site": "node scripts/site/build.mjs && python3 scripts/site/charts.py",
    "test:site": "playwright test",
    "check:contracts": "node scripts/comparison/check-contracts.mjs",
    "check:containers": "node scripts/comparison/check-containers.mjs",
    "check:container-tails": "node scripts/profiling/container-tails.mjs --check reports/container-tail-work.json",
    "profile:costs": "node scripts/profiling/current-costs.mjs",
    "report:costs": "node scripts/profiling/cost-report.mjs",
    "build:runtime": "node scripts/runtime/build.mjs",
    "bench:runtime": "node scripts/runtime/bench.mjs",
    "report:runtime": "node scripts/runtime/report.mjs",
    "check:scaling-guards": "node scripts/scaling-guards.mjs --check reports/scaling-guards.json",
    "report:budgets": "node scripts/budgets/report.mjs",
    "check:budgets": "node scripts/budgets/check.mjs",
    "build:ownership:current": "node scripts/ownership/current.mjs build",
    "check:ownership:current": "node scripts/ownership/current.mjs check --check reports/ownership-current-results.json",
    "check:ownership:contracts": "node scripts/ownership/current.mjs contracts --check reports/ownership-current-contracts.json",
    "report:ownership:current": "node scripts/ownership/current-report.mjs --check",
    "proof:stack": "node scripts/stack-proof-check.mjs",
    "triage:djot-differences": "node scripts/differential/triage.mjs",
    "bench:djot-triage": "node scripts/differential/performance.mjs"
  },
  "devDependencies": {
    "@djot/djot": "0.3.2",
    "@markup-carve/carve": "github:markup-carve/carve-js#c5df77f658c80a3a80a4d31ec1855d854e5da648",
    "@playwright/test": "1.63.0",
    "carve-comparison": "github:markup-carve/carve-js#6d02fa7062dd03024e7c092016459602e9a7aeec",
    "carve-tail-baseline": "github:markup-carve/carve-js#8fe00fd672e1d9af43fe1f92ca1cc64387412990",
    "carve-tail-candidate": "github:markup-carve/carve-js#5001ebb049eda7b68e1905aa96ccf47aa92b1109",
    "commonmark": "0.31.2",
    "ohm-js": "^17.5.0",
    "parse5": "7.3.0"
  }
}
