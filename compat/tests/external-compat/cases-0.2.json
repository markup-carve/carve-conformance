{
  "schemaVersion": 1,
  "cases": {
    "thematic-break": {
      "carve": "Before.\n\n***\n\nAfter.\n"
    },
    "gfm-strike": {
      "carve": "A {~deleted~} word.\n"
    },
    "adjacent-sibling-lists": {
      "declared": {
        "docutils": {
          "clause": "C2-B-062",
          "reason": "Docutils and AsciiDoc do not encode list spacing, so their adapters read loose lists; a list is loose only when a blank line stands between two of its items, so these one-item lists are tight in 0.2 and no Carve source spells them loose."
        },
        "asciidoctor": {
          "clause": "C2-B-062",
          "reason": "Docutils and AsciiDoc do not encode list spacing, so their adapters read loose lists; a list is loose only when a blank line stands between two of its items, so these one-item lists are tight in 0.2 and no Carve source spells them loose."
        }
      }
    },
    "bare-reference-definition": {
      "declared": {
        "*": {
          "clause": "C2-A-107",
          "reason": "A bare [r]: is paragraph text (C2-A-077), and the unresolved use stays a link node without href in the 0.2 tree; Markdown readers keep the use as plain text. Both render the same text."
        }
      }
    },
    "list-before-quote": {
      "declared": {
        "docutils": {
          "clause": "C2-B-062",
          "reason": "Docutils and AsciiDoc do not encode list spacing, so their adapters read loose lists; a list is loose only when a blank line stands between two of its items, so these one-item lists are tight in 0.2 and no Carve source spells them loose."
        }
      }
    },
    "basic-table": {
      "pending": {
        "ticket": "markup-carve/carve-conformance#27",
        "reason": "Table adapters move to the 0.2 table groups, cell paragraphs and columns in the table stage."
      }
    },
    "table-inline-combinations": {
      "pending": {
        "ticket": "markup-carve/carve-conformance#27",
        "reason": "Table adapters move to the 0.2 table groups, cell paragraphs and columns in the table stage."
      }
    },
    "note-in-table-cell": {
      "pending": {
        "ticket": "markup-carve/carve-conformance#27",
        "reason": "Table adapters move to the 0.2 table groups, cell paragraphs and columns in the table stage."
      }
    }
  },
